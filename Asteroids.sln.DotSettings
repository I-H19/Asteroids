	<s:String x:Key="/Default/CodeEditing/Unity/AdditionalFileLayout/Pattern/@EntryValue">&lt;Patterns xmlns=&quot;urn:schemas-jetbrains-com:member-reordering-patterns&quot; xmlns:unity=&quot;urn:schemas-jetbrains-com:member-reordering-patterns-unity&quot;&gt;&lt;TypePattern DisplayName=&quot;Unity classes&quot; Priority=&quot;100&quot;&gt;&lt;TypePattern.Match&gt;&lt;unity:SerializableClass /&gt;&lt;/TypePattern.Match&gt;&lt;Entry DisplayName=&quot;Public static fields and constants&quot;&gt;&lt;Entry.Match&gt;&lt;And&gt;&lt;Access Is=&quot;Public&quot; /&gt;&lt;Or&gt;&lt;Kind Is=&quot;Constant&quot; /&gt;&lt;And&gt;&lt;Kind Is=&quot;Field&quot; /&gt;&lt;Static /&gt;&lt;/And&gt;&lt;/Or&gt;&lt;/And&gt;&lt;/Entry.Match&gt;&lt;/Entry&gt;&lt;Entry DisplayName=&quot;Non-public static fields and constants&quot;&gt;&lt;Entry.Match&gt;&lt;And&gt;&lt;Not&gt;&lt;Access Is=&quot;Public&quot; /&gt;&lt;/Not&gt;&lt;Or&gt;&lt;Kind Is=&quot;Constant&quot; /&gt;&lt;And&gt;&lt;Kind Is=&quot;Field&quot; /&gt;&lt;Static /&gt;&lt;/And&gt;&lt;/Or&gt;&lt;/And&gt;&lt;/Entry.Match&gt;&lt;/Entry&gt;&lt;Entry DisplayName=&quot;Public serialized fields&quot;&gt;&lt;Entry.Match&gt;&lt;And&gt;&lt;Access Is=&quot;Public&quot; /&gt;&lt;unity:SerializedField /&gt;&lt;/And&gt;&lt;/Entry.Match&gt;&lt;/Entry&gt;&lt;Entry DisplayName=&quot;Non-public serialized fields&quot;&gt;&lt;Entry.Match&gt;&lt;And&gt;&lt;Not&gt;&lt;Access Is=&quot;Public&quot; /&gt;&lt;/Not&gt;&lt;unity:SerializedField /&gt;&lt;/And&gt;&lt;/Entry.Match&gt;&lt;/Entry&gt;&lt;Entry DisplayName=&quot;Public serialized auto-properties&quot;&gt;&lt;Entry.Match&gt;&lt;And&gt;&lt;Access Is=&quot;Public&quot; /&gt;&lt;unity:AutoPropertyWithSerializedBackingField /&gt;&lt;/And&gt;&lt;/Entry.Match&gt;&lt;/Entry&gt;&lt;Entry DisplayName=&quot;Non-public serialized auto-properties&quot;&gt;&lt;Entry.Match&gt;&lt;And&gt;&lt;Not&gt;&lt;Access Is=&quot;Public&quot; /&gt;&lt;/Not&gt;&lt;unity:AutoPropertyWithSerializedBackingField /&gt;&lt;/And&gt;